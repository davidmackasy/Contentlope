# Copy to .env.local for local setup. Configure hosted credentials as Cloudflare secrets.
# Use your current deployment URL until the custom domain is connected.
APP_URL=https://tryriffi.com
ADMIN_EMAILS=
TOKEN_ENCRYPTION_KEY=
MAIL_API_KEY=
MAIL_FROM=
MAIL_API_URL=https://api.resend.com/emails
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CREATOR_PRICE_ID=
STRIPE_GROWTH_PRICE_ID=
AI_TEXT_API_KEY=
AI_TEXT_BASE_URL=https://api.openai.com/v1
AI_TEXT_MODEL=gpt-4.1-mini
AI_IMAGE_API_KEY=
AI_IMAGE_BASE_URL=https://api.openai.com/v1
AI_IMAGE_MODEL=gpt-image-2.5-flare
AI_IMAGE_EDIT_MODEL=gpt-image-2.5-sunburst
# Video adapter expects POST /generate -> {id}, GET /jobs/:id -> {status,output_url}
AI_VIDEO_API_KEY=
AI_VIDEO_BASE_URL=
AI_VIDEO_MODEL=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_API_VERSION=v24.0
# Set enabled only after configuring a verified recurring worker trigger.
SCHEDULER_ENABLED=false
SCHEDULER_SECRET=

POSTFORME_API_KEY=
# true only for custom OAuth credentials; Quickstart uses the dashboard redirect URL.

# Optional TikTok white-label project; other platforms retain their existing project.
POSTFORME_TIKTOK_API_KEY=

# Paid reference-video creation (server secrets; never NEXT_PUBLIC_).
FAL_KEY=
# Set only after checking provider costs and deciding your credit margin.
VIDEO_CREDITS_PER_SECOND=
# Stripe one-time payment prices for 100 and 500 credits respectively.
STRIPE_VIDEO_STARTER_PRICE_ID=
STRIPE_VIDEO_STUDIO_PRICE_ID=
